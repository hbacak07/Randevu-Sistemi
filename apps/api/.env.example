NODE_ENV=development
PORT=4000

# docker-compose.yml ile uyumlu varsayılanlar
DATABASE_URL=postgresql://randevu:randevu@localhost:5432/randevu?schema=public
REDIS_URL=redis://localhost:6379

# Üretimde mutlaka uzun ve rastgele bir değer kullanın
JWT_SECRET=degistir-beni-cok-gizli-bir-anahtar
JWT_EXPIRES_IN=7d

# Frontend adresi (CORS için)
CORS_ORIGIN=http://localhost:5173

# Randevudan kaç dakika önce hatırlatma gönderilsin
REMINDER_MINUTES_BEFORE=60
